---
import PageLayout from '../layouts/PageLayout.astro';
import Placeholder from '../components/Placeholder.astro';

const reasons = ['Retreat enquiries', 'Speaking invitations', 'Working together', 'Spiritual direction', 'Anything else'];
---
<PageLayout title="Contact" eyebrow="Write to us" intro="We’d love to hear from you.">
  <div class="grid gap-14 lg:grid-cols-2">
    <section aria-labelledby="reasons">
      <h2 id="reasons" class="text-3xl text-midnight">Get in touch about</h2>
      <ul class="mt-6 divide-y divide-midnight/15 border-y border-midnight/15">
        {reasons.map((r) => <li class="py-4 font-display text-2xl text-midnight">{r}</li>)}
      </ul>
    </section>

    <section aria-labelledby="send" class="rounded-3xl bg-midnight p-8 text-ivory on-dark md:p-12">
      <h2 id="send" class="text-3xl">Send a message</h2>
      <Placeholder class="mt-6" label="Coming soon">Contact form goes here once Iva confirms which email to use.</Placeholder>
      <p class="mt-8 text-sm text-ivory/70">In a crisis, call 112 or 999, or Samaritans free on 116 123.</p>
    </section>
  </div>
</PageLayout>

---
import PageLayout from '../layouts/PageLayout.astro';
import RetreatList from '../components/RetreatList.astro';
import Placeholder from '../components/Placeholder.astro';

const kinds = [
  { title: 'Quiet days', text: 'A day of prayer and silence.' },
  { title: 'Weekend retreats', text: 'Time away to rest and pray.' },
  { title: 'Evenings of prayer', text: 'In a parish or online.' },
  { title: 'For your group', text: 'A retreat for your parish or community.' },
];
---
<PageLayout title="Retreats & Events" eyebrow="Time set apart" intro="Come as you are. No experience needed.">
  <section aria-labelledby="upcoming">
    <h2 id="upcoming" class="text-4xl text-midnight">Coming up</h2>
    <div class="mt-8"><RetreatList /></div>
  </section>

  <section class="mt-20" aria-labelledby="kinds">
    <h2 id="kinds" class="text-4xl text-midnight">Ways to take part</h2>
    <ul class="mt-8 grid gap-8 sm:grid-cols-2 lg:grid-cols-4">
      {kinds.map((k) => (
        <li class="border-t border-midnight/20 pt-5">
          <h3 class="text-2xl text-midnight">{k.title}</h3>
          <p class="mt-1 text-ink-soft">{k.text}</p>
        </li>
      ))}
    </ul>
    <Placeholder class="mt-8" label="To confirm with Iva">Which formats she offers now.</Placeholder>
  </section>

  <section class="mt-20 flex flex-col items-start justify-between gap-6 rounded-3xl bg-parchment p-8 md:flex-row md:items-center md:p-12">
    <p class="font-display text-3xl text-midnight">Want a retreat for your group?</p>
    <a href="/contact/" class="btn btn-primary">Ask about a retreat</a>
  </section>
  <p class="mt-8 text-sm text-ink-soft">Retreats offer spiritual support, not medical or psychological treatment.</p>
</PageLayout>

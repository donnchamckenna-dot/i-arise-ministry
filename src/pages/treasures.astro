---
import PageLayout from '../layouts/PageLayout.astro';
import Placeholder from '../components/Placeholder.astro';
import KeyMotif from '../components/KeyMotif.astro';

/**
 * Treasures: the building blocks of Iva's life and work.
 * Not a blog. Add, remove or reorder entries here.
 */
type Treasure = { slug: string; kind: string; title: string; dates?: string; line: string; tone: string };
const treasures: Treasure[] = [
  { slug: 'beauty', kind: 'What I treasure', title: 'Beauty', line: 'In nature, in art, in people. Beauty can open a closed heart to God. Admiring beauty is my daily practice. It has helped me in bereavement. And beauty always lifts a heart to God, who is Beauty itself.', tone: 'bg-parchment text-midnight' },
  { slug: 'healing', kind: 'What I treasure', title: 'Healing', line: 'The heart of my ministry. Underneath all pain, joy is hidden.', tone: 'bg-restoration-deep text-white on-dark' },
  { slug: 'golden-shamrock', kind: 'What I treasure', title: 'The golden shamrock', line: 'Ireland is covered in gold, and gold is His presence. The shamrock is a symbol of Ireland. It also represents the Trinity, reminds us of St Patrick and of our baptism.', tone: 'bg-midnight text-ivory on-dark' },
  { slug: 'oxford', kind: 'A place I love', title: 'Oxford', line: 'There are a few cities that have attracted me with their stories, because something in their story wants to illuminate mine. In recent years Oxford has been alluring me like a stranger who wished to become an old friend. A city of learning, prayer and old stone, and home to C. S. Lewis and J. R. R. Tolkien. This is where beauty, wisdom and wonder meet everyday life.', tone: 'bg-contemplative text-ivory on-dark' },
  { slug: 'st-patrick', kind: 'The shamrock', title: 'St Patrick', dates: '5th century', line: 'Taken to Ireland as a slave, he came back to bring the Gospel. He became a mirror of God’s love for the Irish. His life is a testament that our worst experiences, through God’s goodness and love, can lead us to write a story with our lives that is so much greater than anything we could have ever imagined. The inspiration for I Arise Ministry.', tone: 'bg-sage text-ivory on-dark' },
  { slug: 'st-john-of-the-cross', kind: 'The cross', title: 'St John of the Cross', dates: '1542 to 1591', line: 'Carmelite poet and mystic. The dark night of the soul has a purpose: to draw us closer to God. I was born on his feast day, in the shadow of the cross. His teaching on the purification of memory helped me when a deeply suppressed memory surfaced. While it was terrifying, I knew the process was for my good. The dark night truly leads us towards more Light and Love.', tone: 'bg-midnight text-ivory on-dark' },
  { slug: 'st-philip-neri', kind: 'The fire', title: 'St Philip Neri', dates: '1515 to 1595', line: 'The joyful saint of Rome, his heart on fire with the love of God. My favourite. Once in Oxford I saw a painting of him and wondered, “who is he?” Little did I know that only a month after, I would find out in the most unusual way. I wanted to visit the church with his remains in Rome. When I got there, the door was closed. The story that followed was so miraculous that I now consider him my intercessor for closed doors opening, at the right time. He keeps showing me how beautiful it is to be loved.', tone: 'bg-parchment text-midnight' },
  { slug: 'st-therese', kind: 'The heart', title: 'St Thérèse of Lisieux', dates: '1873 to 1897', line: 'One of my closest friends in Heaven. Known as the Little Flower, whose little way was love. She teaches us that “without love, deeds, even the most brilliant, count as nothing”. She trusted God completely and never doubted His mercy, understanding well that God is the only one who deserves such trust.', tone: 'bg-restoration-deep text-white on-dark' },
  { slug: 'jane-austen', kind: 'A friend on the page', title: 'Jane Austen', dates: '1775 to 1817', line: 'A deep connection. Her wisdom and humour, her life story, the living of the virtues, and a deep understanding of our intrinsic dignity that some of her heroines embody.', tone: 'bg-ivory text-midnight border border-midnight/15' },
  { slug: 'cs-lewis', kind: 'A friend on the page', title: 'C. S. Lewis', dates: '1898 to 1963', line: 'Born in Belfast, a scholar at Oxford. His stories have brought so much meaning and beauty. I visit his grave every time I’m in Oxford. The Chronicles of Narnia are my favourite books. There is something truly touching about his search for joy, and then meeting a woman called Joy, who would later become his wife. He resisted what eventually brought true fulfilment: his conversion to faith, and to love. Thankfully, this resistance didn’t win. Who knows what wonders await us when we, too, don’t allow resistance to the beauty of life to stop us from new discoveries.', tone: 'bg-contemplative text-ivory on-dark' },
  { slug: 'tolkien', kind: 'A friend on the page', title: 'J. R. R. Tolkien', dates: '1892 to 1973', line: 'Stories where the battles make the heroes rather than break them, and good triumphs over evil. His Catholic faith shines through, even when he isn’t aware of it. I hope one day he might be considered as a saint.', tone: 'bg-sage text-ivory on-dark' },
];
---
<PageLayout
  title="Treasures"
  eyebrow="Building blocks of my life and work"
  intro="These are the things I treasure. They shape my work and my life, what drives me, and what inspires my retreats, talks and journey with God."
>
  <Placeholder class="mb-12" label="For Iva">Check each line, and add anything you would like to say in your own words. You can also add treasures at any time.</Placeholder>

  <ul class="columns-1 gap-8 md:columns-2 lg:columns-3 [&>li]:mb-8 [&>li]:break-inside-avoid">
    {treasures.map((t, i) => (
      <li id={t.slug} class:list={['scroll-mt-8 rounded-2xl p-8 shadow-lg shadow-midnight/10', t.tone, i % 3 === 1 && 'md:rounded-t-[999px] md:pt-16']} data-reveal>
        <KeyMotif size={64} name={t.slug === 'golden-shamrock' || t.slug === 'st-patrick' ? 'shamrock' : 'key'} />
        <p class="eyebrow mt-4 opacity-80">{t.kind}</p>
        <h2 class="mt-1 text-4xl">{t.title}</h2>
        {t.dates && <p class="mt-1 text-sm opacity-75">{t.dates}</p>}
        <p class="mt-4 text-lg opacity-90">{t.line}</p>
      </li>
    ))}
  </ul>

  <p class="mx-auto mt-16 max-w-xl text-center font-display text-2xl italic text-midnight">
    More treasures will be added from time to time.
  </p>
</PageLayout>

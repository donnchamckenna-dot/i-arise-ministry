---
import PageLayout from '../layouts/PageLayout.astro';
import Placeholder from '../components/Placeholder.astro';
---
<PageLayout title="Privacy" intro="How this website handles your information.">
  <div class="measure space-y-4 text-ink-soft">
    <p>This website does not use advertising or tracking cookies, and does not use analytics.</p>
    <Placeholder label="Before launch">Full privacy notice to be written once the contact form and mailing list provider are chosen, in line with GDPR and Irish data protection law.</Placeholder>
  </div>
</PageLayout>

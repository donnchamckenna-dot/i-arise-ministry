---
import PageLayout from '../layouts/PageLayout.astro';
import Placeholder from '../components/Placeholder.astro';
import { spiritualityThemes } from '../config/site';

/** One short paragraph per theme. Each can grow into its own page later. */
const body: Record<string, string> = {
  'healing-of-memories': 'Praying with our past. We bring a painful memory to God and ask Christ to meet us there. It works alongside, not instead of, professional care.',
  'st-john-of-the-cross': 'A 16th-century Spanish Carmelite poet and saint. He wrote about “the dark night”: times when God feels far away but is actually drawing close.',
  'st-john-henry-newman': 'A 19th-century English saint and cardinal, and founder of the Catholic University of Ireland in Dublin. He wrote beautifully about conscience and faith.',
  'carmelite-spirituality': 'A tradition of prayer and silence going back to Mount Carmel. Its saints include Teresa of Ávila and Thérèse of Lisieux.',
  'prayer-and-contemplation': 'Simple ways to be still with God: silence, slow reading of Scripture, and resting in his presence. Not just for monks and nuns.',
  'forgiveness-and-reconciliation': 'Forgiveness lets go of the hurt. It doesn’t mean what happened was OK. Reconciliation mends the relationship, when that is possible.',
  'restoration-and-hope': 'Christian hope is trust that God keeps his promises. Restoration is that hope, lived out slowly over time.',
};
---
<PageLayout title="Healing & Spirituality" eyebrow="Pathways" intro="The teachers and practices behind this ministry.">
  <ul class="grid gap-x-14 gap-y-12 md:grid-cols-2">
    {spiritualityThemes.map((t, i) => (
      <li id={t.slug} class="scroll-mt-8 border-t border-midnight/20 pt-6">
        <p class="font-display text-3xl italic text-restoration" aria-hidden="true">{String(i + 1).padStart(2, '0')}</p>
        <h2 class="mt-1 text-3xl text-midnight">{t.title}</h2>
        <p class="mt-3 text-lg text-ink-soft">{body[t.slug]}</p>
      </li>
    ))}
  </ul>
  <Placeholder class="mt-14" label="For Iva to review">Check these for accuracy and voice.</Placeholder>
</PageLayout>

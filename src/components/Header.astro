---
import { mainNav } from '../config/site';
interface Props { tone?: 'light' | 'dark'; }
const { tone = 'light' } = Astro.props;
const dark = tone === 'dark';
const path = Astro.url.pathname;
const isCurrent = (href: string) => (href === '/' ? path === '/' : path.startsWith(href));
---
<header
  class:list={[
    'z-40 w-full',
    dark ? 'absolute inset-x-0 top-0 text-ivory on-dark' : 'relative bg-ivory text-midnight border-b border-midnight/10',
  ]}
>
  <div class="container-page flex items-center justify-between gap-6 py-4 md:py-6 xl:grid xl:grid-cols-[1fr_auto_1fr]">

    <!-- Desktop menu -->
    <nav aria-label="Main" class="hidden xl:col-start-2 xl:block">
      <ul class="flex items-center gap-7 whitespace-nowrap text-[1.02rem]">
        {mainNav.map((item) => (
          <li class="relative">
            {item.children ? (
              <details class="group/dd" data-dropdown>
                <summary
                  class:list={[
                    'flex cursor-pointer list-none items-center gap-1.5 py-2 underline-offset-[0.35em] decoration-1 hover:underline [&::-webkit-details-marker]:hidden',
                    isCurrent(item.href) && 'underline',
                  ]}
                >
                  {item.label}
                  <svg class="h-3 w-3 transition-transform group-open/dd:rotate-180" viewBox="0 0 12 12" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><path d="M2 4l4 4 4-4" /></svg>
                </summary>
                <ul class="absolute left-1/2 top-full mt-2 w-64 -translate-x-1/2 rounded-2xl bg-midnight p-2 text-ivory shadow-2xl on-dark">
                  {item.children.map((c) => (
                    <li>
                      <a
                        href={c.href}
                        aria-current={isCurrent(c.href) ? 'page' : undefined}
                        class="block rounded-xl px-4 py-3 font-display text-xl no-underline hover:bg-ivory/10"
                      >{c.label}</a>
                    </li>
                  ))}
                </ul>
              </details>
            ) : (
              <a
                href={item.href}
                aria-current={isCurrent(item.href) ? 'page' : undefined}
                class:list={[
                  'py-2 no-underline underline-offset-[0.35em] decoration-1 hover:underline',
                  isCurrent(item.href) && 'underline',
                ]}
              >{item.label}</a>
            )}
          </li>
        ))}
      </ul>
    </nav>

    <!-- Desktop call to action -->
    <a
      href="#contact"
      class:list={[
        'hidden xl:col-start-3 xl:inline-flex xl:justify-self-end items-center rounded-sm border px-5 py-2.5 text-[0.8rem] font-medium uppercase tracking-[0.18em] no-underline transition-colors',
        dark ? 'border-ivory/60 hover:bg-ivory hover:text-midnight' : 'border-midnight/40 hover:bg-midnight hover:text-ivory',
      ]}
    >Contact me</a>

    <!-- Mobile menu: works without JavaScript -->
    <details class="group ml-auto xl:hidden">
      <summary
        class:list={[
          'flex min-h-11 cursor-pointer list-none items-center gap-2 rounded-full border px-4 text-sm font-medium [&::-webkit-details-marker]:hidden',
          dark ? 'border-ivory/50' : 'border-midnight/30',
        ]}
      >
        <span class="group-open:hidden">Menu</span>
        <span class="hidden group-open:inline">Close</span>
      </summary>
      <nav
        aria-label="Main"
        class="absolute inset-x-0 top-full mx-4 mt-1 rounded-2xl bg-midnight p-3 text-ivory shadow-2xl on-dark"
      >
        <ul>
          {mainNav.map((item) => (
            <li>
              <a
                href={item.href}
                aria-current={path === item.href ? 'page' : undefined}
                class="block rounded-xl px-4 py-3 font-display text-2xl no-underline hover:bg-ivory/10"
              >{item.label}</a>
              {item.children && (
                <ul class="mb-2 ml-4 border-l border-gold/40 pl-2">
                  {item.children.map((c) => (
                    <li>
                      <a href={c.href} aria-current={isCurrent(c.href) ? 'page' : undefined} class="block rounded-xl px-4 py-2 text-lg text-ivory/85 no-underline hover:bg-ivory/10">{c.label}</a>
                    </li>
                  ))}
                </ul>
              )}
            </li>
          ))}
        </ul>
      </nav>
    </details>
  </div>
</header>

<script>
  // Close the desktop dropdown when clicking elsewhere or pressing Escape.
  const dropdowns = document.querySelectorAll<HTMLDetailsElement>('details[data-dropdown]');
  document.addEventListener('click', (e) => {
    dropdowns.forEach((d) => { if (!d.contains(e.target as Node)) d.open = false; });
  });
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') dropdowns.forEach((d) => {
      if (d.open) { d.open = false; d.querySelector('summary')?.focus(); }
    });
  });
</script>

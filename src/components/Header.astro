---
import { Image } from 'astro:assets';
import { site, mainNav } from '../config/site';
import shamrock from '../assets/brand/shamrock-badge.png';
interface Props { tone?: 'light' | 'dark'; }
const { tone = 'light' } = Astro.props;
const dark = tone === 'dark';
const path = Astro.url.pathname;
const isCurrent = (href: string) => path === href || path.startsWith(href);
---
<header
  class:list={[
    'z-40 w-full',
    dark ? 'absolute inset-x-0 top-0 text-ivory on-dark' : 'relative bg-ivory text-midnight border-b border-midnight/10',
  ]}
>
  <div class="container-page flex items-center justify-between gap-6 py-4 md:py-6">
    <a href="/" class="flex items-center gap-3 no-underline" aria-label={`${site.name}, home`}>
      {/* Cropped from the supplied 1080px logo. TODO-CONTENT: swap for the original file (transparent PNG or SVG) when available. */}
      <Image src={shamrock} alt="" width={48} height={48} densities={[1, 2]} class="h-12 w-12 shrink-0 rounded-full" loading="eager" />

      <span class="font-display text-[1.6rem] leading-none tracking-tight">
        I Arise <span class="italic">Ministry</span>
      </span>
    </a>

    <nav aria-label="Main" class="hidden lg:block">
      <ul class="flex items-center gap-7 text-[0.95rem]">
        {mainNav.map((item) => (
          <li>
            <a
              href={item.href}
              aria-current={isCurrent(item.href) ? 'page' : undefined}
              class:list={[
                'py-2 no-underline underline-offset-[0.35em] decoration-1 hover:underline',
                isCurrent(item.href) && 'underline',
              ]}
            >{item.label}</a>
          </li>
        ))}
      </ul>
    </nav>

    <!-- Mobile menu: works without JavaScript -->
    <details class="group lg:hidden">
      <summary
        class:list={[
          'flex min-h-11 cursor-pointer list-none items-center gap-2 rounded-full border px-4 text-sm font-semibold [&::-webkit-details-marker]:hidden',
          dark ? 'border-ivory/50' : 'border-midnight/30',
        ]}
      >
        <span class="group-open:hidden">Menu</span>
        <span class="hidden group-open:inline">Close</span>
      </summary>
      <nav
        aria-label="Main"
        class="absolute inset-x-0 top-full mx-4 mt-1 rounded-2xl bg-midnight p-3 text-ivory shadow-2xl on-dark"
      >
        <ul>
          {mainNav.map((item) => (
            <li>
              <a
                href={item.href}
                aria-current={isCurrent(item.href) ? 'page' : undefined}
                class="block rounded-xl px-4 py-3 font-display text-2xl no-underline hover:bg-ivory/10"
              >{item.label}</a>
            </li>
          ))}
        </ul>
      </nav>
    </details>
  </div>
</header>

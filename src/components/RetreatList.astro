---
/**
 * Lists upcoming, published retreats. Shows a gentle empty state when none
 * are scheduled. Data comes only from src/content/retreats/.
 */
import { getCollection } from 'astro:content';
interface Props { limit?: number; }
const { limit } = Astro.props;

const now = new Date();
const all = await getCollection('retreats', ({ data }) => !data.draft && (data.end ?? data.start) >= now);
const upcoming = all.sort((a, b) => a.data.start.getTime() - b.data.start.getTime()).slice(0, limit ?? all.length);

const fmt = new Intl.DateTimeFormat('en-IE', { weekday: 'short', day: 'numeric', month: 'long', year: 'numeric' });
const statusLabel: Record<string, string> = {
  open: 'Booking open',
  'few-places': 'A few places left',
  full: 'Fully booked',
  'waiting-list': 'Waiting list',
  closed: 'Booking closed',
};
const formatLabel = { 'in-person': 'In person', online: 'Online', hybrid: 'In person and online' };
---
{upcoming.length > 0 ? (
  <ul class="divide-y divide-midnight/15 border-y border-midnight/15">
    {upcoming.map(({ data }) => (
      <li class="grid gap-3 py-8 md:grid-cols-[12rem_1fr_auto] md:items-baseline md:gap-8">
        <p class="eyebrow text-restoration-deep">
          <time datetime={data.start.toISOString()}>{fmt.format(data.start)}</time>
        </p>
        <div>
          <h3 class="text-3xl">{data.title}</h3>
          <p class="mt-2 text-ink-soft">{data.summary}</p>
          <p class="mt-3 text-sm text-ink-soft">
            {formatLabel[data.format]}{data.location && ` · ${data.location}`} · Led by {data.leader}
          </p>
        </div>
        <div class="flex flex-col items-start gap-2 md:items-end">
          <span class="text-sm font-medium text-sage">{statusLabel[data.status]}</span>
          {data.registrationUrl && data.status !== 'closed' && data.status !== 'full' && (
            <a href={data.registrationUrl} class="btn btn-ghost">Register<span class="sr-only"> for {data.title}</span></a>
          )}
        </div>
      </li>
    ))}
  </ul>
) : (
  <div class="rounded-2xl border border-midnight/15 bg-white/50 px-6 py-10 text-center md:px-12">
    <p class="font-display text-3xl">No retreats are scheduled just now.</p>
    <p class="mx-auto mt-3 max-w-md text-ink-soft">New dates are coming soon.</p>
    <a href="#contact" class="link mt-5 inline-block font-medium">Ask about a retreat</a>
  </div>
)}

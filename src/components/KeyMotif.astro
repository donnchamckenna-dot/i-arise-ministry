---
/**
 * The golden key: Iva's key artwork as a small 3D emblem, used as a section
 * marker. Decorative only. `size` is its width in pixels.
 */
import Emblem3D from './Emblem3D.astro';
interface Props { class?: string; size?: number; name?: 'key' | 'shamrock'; }
const { class: className = '', size = 72, name = 'key' } = Astro.props;
const px = Math.round(size * 1.9);
---
<Emblem3D name={name} size={`${px}px`} sparkles={px >= 110} shadow={false} class={className} />

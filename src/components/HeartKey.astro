---
/**
 * Large feature key with a heart-shaped bow: "unlocking the heart".
 * Used once per page at most, as a closing emblem. Decorative only.
 */
interface Props { class?: string; }
const { class: className = '' } = Astro.props;
---
<div class:list={['relative mx-auto w-full max-w-[26rem]', className]} aria-hidden="true">
  <div class="absolute inset-0 -z-10 m-auto h-3/4 w-3/4 rounded-full bg-gold/30 blur-3xl"></div>
  <svg viewBox="0 0 320 120" class="w-full" fill="none" stroke-linecap="round" stroke-linejoin="round">
    <defs>
      <linearGradient id="hk-gold" gradientUnits="userSpaceOnUse" x1="0" y1="0" x2="320" y2="120">
        <stop offset="0" stop-color="#e9c785" />
        <stop offset="0.55" stop-color="#d9ad65" />
        <stop offset="1" stop-color="#a87a2c" />
      </linearGradient>
    </defs>
    <!-- heart bow -->
    <path
      d="M60 98 C 22 74, 8 52, 14 34 C 20 16, 44 12, 60 32 C 76 12, 100 16, 106 34 C 112 52, 98 74, 60 98 Z"
      stroke="url(#hk-gold)" stroke-width="7"
    />
    <path
      d="M60 74 C 42 62, 36 52, 39 44 C 42 36, 53 35, 60 44 C 67 35, 78 36, 81 44 C 84 52, 78 62, 60 74 Z"
      fill="#cb5b59" fill-opacity="0.9"
    />
    <!-- collar -->
    <path d="M108 58 h14 M122 48 v20 M132 50 v16" stroke="url(#hk-gold)" stroke-width="6" />
    <!-- shaft -->
    <path d="M132 58 H298" stroke="url(#hk-gold)" stroke-width="7" />
    <!-- bit -->
    <path d="M258 58 v22 h12 v-12 h10 v18 h16 V58" stroke="url(#hk-gold)" stroke-width="6" />
    <!-- small sparkles -->
    <path d="M150 22 v10 M145 27 h10 M232 90 v8 M228 94 h8" stroke="#d9ad65" stroke-width="2" />
  </svg>
</div>

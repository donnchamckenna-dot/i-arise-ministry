---
/**
 * Large feature key: Iva's key artwork as a 3D emblem with the heart at its
 * centre ("unlocking the heart"). Used once per page at most. Decorative only.
 */
import Emblem3D from './Emblem3D.astro';
interface Props { class?: string; }
const { class: className = '' } = Astro.props;
---
<div class:list={['relative mx-auto w-full max-w-[26rem]', className]}>
  <Emblem3D name="key" size="100%" />
</div>

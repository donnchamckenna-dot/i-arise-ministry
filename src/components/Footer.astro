---
import { site, mainNav, journeyNav, contact } from '../config/site';
import KeyMotif from './KeyMotif.astro';
import Placeholder from './Placeholder.astro';
const year = new Date().getFullYear();
const links = [...mainNav.filter((n) => !n.children), { label: 'Vision', href: '/vision/' }, ...journeyNav, { label: 'Privacy', href: '/privacy/' }];
---
<footer id="contact" class="scroll-mt-4 bg-midnight text-ivory on-dark">
  <div class="container-page grid gap-14 py-16 md:grid-cols-[1.4fr_1fr] md:py-20">
    <section aria-labelledby="contact-title">
      <KeyMotif class="text-gold" size={84} />
      <h2 id="contact-title" class="mt-6 text-4xl md:text-5xl">Contact me</h2>
      <p class="mt-3 max-w-md text-lg text-ivory/80">I’d love to hear from you. Write to me about spiritual direction, retreats, talks, courses, or anything on your heart.</p>
      <ul class="mt-8 space-y-4 text-lg">
        <li>
          <a href={`mailto:${contact.email}`} class="group inline-flex items-center gap-3 no-underline">
            <svg class="h-6 w-6 text-gold" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><rect x="3" y="5" width="18" height="14" rx="2" /><path d="M3.5 6.5 12 13l8.5-6.5" /></svg>
            <span class="group-hover:underline">{contact.email}</span>
          </a>
        </li>
        {contact.instagram && (
          <li>
            <a href={contact.instagram} class="group inline-flex items-center gap-3 no-underline" rel="me">
              <svg class="h-6 w-6 text-gold" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><rect x="3" y="3" width="18" height="18" rx="5" /><circle cx="12" cy="12" r="4" /><circle cx="17.3" cy="6.7" r="0.9" fill="currentColor" /></svg>
              <span class="group-hover:underline">Instagram</span>
            </a>
          </li>
        )}
        {contact.linkedin && (
          <li>
            <a href={contact.linkedin} class="group inline-flex items-center gap-3 no-underline" rel="me">
              <svg class="h-6 w-6 text-gold" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><rect x="3" y="3" width="18" height="18" rx="3" /><path d="M8 10.5V17M8 7.5v.01M11.5 17v-6.5M11.5 13.5c0-2 1.2-3 2.7-3s2.3 1 2.3 3V17" /></svg>
              <span class="group-hover:underline">LinkedIn</span>
            </a>
          </li>
        )}
      </ul>
      {(!contact.instagram || !contact.linkedin) && (
        <Placeholder class="mt-6 max-w-md" label="Needed">Links to Iva’s Instagram and LinkedIn profiles.</Placeholder>
      )}
    </section>
    <nav aria-label="Footer" class="md:pt-24">
      <p class="font-display text-2xl">I Arise <span class="italic">Ministry</span></p>
      <ul class="mt-4 grid grid-cols-2 gap-x-6 gap-y-1 text-[1rem]">
        {links.map((item) => (
          <li><a href={item.href} class="inline-block py-1.5 text-ivory/80 no-underline hover:text-ivory hover:underline">{item.label}</a></li>
        ))}
      </ul>
    </nav>
  </div>
  <div class="border-t border-ivory/15">
    <div class="container-page py-6 text-sm text-ivory/70">
      <p>© {year} {site.name}. Founded by {site.founder}.</p>
    </div>
  </div>
</footer>

---
import { site, footerNav } from '../config/site';
import KeyMotif from './KeyMotif.astro';
const year = new Date().getFullYear();
---
<footer class="bg-midnight text-ivory on-dark">
  <div class="container-page grid gap-12 py-16 md:grid-cols-[1.3fr_1fr]">
    <div>
      <KeyMotif class="text-gold" size={84} />
      <p class="mt-6 font-display text-3xl leading-tight">I Arise <span class="italic">Ministry</span></p>
      <p class="mt-3 max-w-sm text-ivory/80">
        Healing of memories, restoration of the person and renewal of communities, rooted in prayer.
      </p>
    </div>
    <nav aria-label="Footer">
      <ul class="grid grid-cols-2 gap-x-6 gap-y-2 text-[0.95rem]">
        {footerNav.map((item) => (
          <li><a href={item.href} class="inline-block py-1.5 text-ivory/85 no-underline hover:text-ivory hover:underline">{item.label}</a></li>
        ))}
      </ul>
    </nav>
  </div>
  <div class="border-t border-ivory/15">
    <div class="container-page flex flex-col gap-2 py-6 text-sm text-ivory/70 md:flex-row md:justify-between">
      <p>© {year} {site.name}. Founded by {site.founder}.</p>
      <p>Spiritual and pastoral support is not a substitute for medical or psychological care.</p>
    </div>
  </div>
</footer>

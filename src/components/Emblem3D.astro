---
/**
 * Iva's golden shamrock or key, as a 3D emblem that slowly spins.
 * Hover: it turns to face you and follows the pointer. Drag: turn it by hand.
 * Click or tap: a full spin with a burst of gold.
 * The artwork is unchanged; depth comes from stacked layers (public/emblems/).
 * Reduced-motion visitors see it still, facing forward.
 * Decorative, so hidden from screen readers.
 */
interface Props {
  name: 'shamrock' | 'key';
  size?: string; // any CSS width, e.g. '6rem' or '100%'
  sparkles?: boolean;
  shadow?: boolean;
  class?: string;
  style?: string;
}
const { name, size = '100%', sparkles = true, shadow = true, class: className = '', style = '' } = Astro.props;
---
<div
  class:list={['e3', className]}
  data-emblem3d={name}
  style={`width:${size};${style}`}
  aria-hidden="true"
>
  <div class="e3-glow"></div>
  {shadow && <div class="e3-shadow"></div>}
  <div class="e3-float"><div class="e3-obj"></div></div>
  {sparkles && <canvas class="e3-sparks"></canvas>}
</div>

<style is:global>
  .e3 { position: relative; aspect-ratio: 1 / 1; perspective: 1100px; perspective-origin: 50% 45%; cursor: grab; touch-action: pan-y; user-select: none; -webkit-user-select: none; -webkit-tap-highlight-color: transparent; flex-shrink: 0; }
  .e3.e3-drag { cursor: grabbing; }
  .e3-glow { position: absolute; inset: 14%; border-radius: 50%; pointer-events: none; background: radial-gradient(circle, rgb(255 236 190 / .75) 0%, rgb(255 214 140 / .35) 35%, rgb(255 200 120 / 0) 68%); opacity: .5; transform: scale(.9); transition: opacity .6s ease, transform .6s ease; }
  .e3.e3-hover .e3-glow { opacity: 1; transform: scale(1.12); }
  .e3-shadow { position: absolute; left: 27%; bottom: 7%; width: 46%; height: 6%; border-radius: 50%; pointer-events: none; background: radial-gradient(ellipse, rgb(60 10 10 / .32), rgb(60 10 10 / 0) 70%); }
  .e3-float { position: absolute; inset: 0; transform-style: preserve-3d; pointer-events: none; }
  .e3-obj { position: absolute; inset: 6%; transform-style: preserve-3d; will-change: transform; }
  .e3-obj img, .e3-obj .e3-sheen { position: absolute; inset: 0; width: 100%; height: 100%; display: block; pointer-events: none; -webkit-user-drag: none; max-width: none; }
  .e3-sheen { -webkit-mask-size: 100% 100%; mask-size: 100% 100%; background: radial-gradient(circle at var(--cx, 50%) var(--cy, 50%), rgb(255 252 235 / .55), rgb(255 252 235 / 0) 28%), linear-gradient(105deg, rgb(255 250 225 / 0) 38%, rgb(255 250 225 / .6) 50%, rgb(255 250 225 / 0) 62%); background-size: 100% 100%, 260% 100%; background-position: 0 0, var(--sx, 50%) 0; opacity: var(--so, .5); backface-visibility: hidden; -webkit-backface-visibility: hidden; }
  .e3-sparks { position: absolute; inset: -10%; width: 120%; height: 120%; pointer-events: none; }
</style>

<script>
  type Cfg = { layers: number; depth: number; spin: number; tilt: number; spark: [number, number, number] };
  const CONFIG: Record<string, Cfg> = {
    shamrock: { layers: 12, depth: 0.05, spin: 0.045, tilt: 26, spark: [255, 214, 120] },
    key: { layers: 14, depth: 0.04, spin: 0.038, tilt: 24, spark: [255, 190, 110] },
  };
  const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  type Inst = { el: HTMLElement; visible: boolean; tick: (now: number, dt: number) => void };
  const all: Inst[] = [];

  function setup(stage: HTMLElement) {
    if (stage.dataset.e3Ready) return;
    stage.dataset.e3Ready = '1';
    const name = stage.dataset.emblem3d || 'shamrock';
    const cfg = CONFIG[name];
    const face = `/emblems/${name}-face.webp`, edge = `/emblems/${name}-edge.webp`;
    const obj = stage.querySelector<HTMLElement>('.e3-obj')!;
    const flt = stage.querySelector<HTMLElement>('.e3-float')!;
    const shadow = stage.querySelector<HTMLElement>('.e3-shadow');
    const canvas = stage.querySelector<HTMLCanvasElement>('.e3-sparks');
    const ctx = canvas?.getContext('2d') ?? null;
    const small = stage.getBoundingClientRect().width < 130;
    const layers = small ? 6 : cfg.layers;

    const add = (src: string, z: string) => {
      const i = new Image(); i.src = src; i.alt = ''; i.draggable = false; i.decoding = 'async';
      i.style.transform = `translateZ(${z})`; obj.appendChild(i);
    };
    add(face, 'calc(var(--t) * -0.5)');
    for (let k = 0; k < layers; k++) add(edge, `calc(var(--t) * ${((k + 0.5) / layers - 0.5).toFixed(3)})`);
    add(face, 'calc(var(--t) * 0.5)');
    const sheen = document.createElement('div');
    sheen.className = 'e3-sheen';
    sheen.style.transform = 'translateZ(calc(var(--t) * 0.5 + 0.6px))';
    sheen.style.setProperty('-webkit-mask-image', `url(${edge})`);
    sheen.style.setProperty('mask-image', `url(${edge})`);
    obj.appendChild(sheen);

    const size = () => {
      const w = obj.getBoundingClientRect().width || stage.clientWidth * 0.88;
      obj.style.setProperty('--t', Math.max(w * cfg.depth, 3).toFixed(1) + 'px');
      if (canvas && ctx) {
        const r = canvas.getBoundingClientRect(), dpr = Math.min(devicePixelRatio || 1, 2);
        canvas.width = r.width * dpr; canvas.height = r.height * dpr; ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
      }
    };
    size();
    new ResizeObserver(size).observe(stage);

    const idle = reduce ? 0 : cfg.spin;
    let ry = reduce ? 0 : Math.random() * 360 - 180, rx = 0, vy = idle;
    let hover = false, mx = 0, my = 0, px = 0.5, py = 0.5;
    let dragging = false, lastX = 0, lastT = 0, moved = 0, downAt = 0;
    const t0 = performance.now() - Math.random() * 4000;
    const parts: { x: number; y: number; vx: number; vy: number; life: number; age: number; size: number; rot: number }[] = [];
    const local = (e: PointerEvent) => { const r = stage.getBoundingClientRect(); return { x: (e.clientX - r.left) / r.width, y: (e.clientY - r.top) / r.height }; };
    const toCanvas = (x: number, y: number): [number, number] => {
      if (!canvas) return [0, 0];
      const c = canvas.getBoundingClientRect(), s = stage.getBoundingClientRect();
      return [x * s.width + (s.left - c.left), y * s.height + (s.top - c.top)];
    };
    const spawn = (x: number, y: number, n: number, speed: number, life: number) => {
      if (!ctx) return;
      for (let i = 0; i < n; i++) {
        const a = Math.random() * Math.PI * 2, sp = speed * (0.3 + Math.random());
        parts.push({ x, y, vx: Math.cos(a) * sp, vy: Math.sin(a) * sp - 0.15, life, age: 0, size: 2 + Math.random() * 4, rot: Math.random() * 6 });
      }
    };

    stage.addEventListener('pointerenter', () => { hover = true; stage.classList.add('e3-hover'); });
    stage.addEventListener('pointerleave', () => { if (!dragging) { hover = false; stage.classList.remove('e3-hover'); } });
    stage.addEventListener('pointermove', (e) => {
      const p = local(e); mx = p.x * 2 - 1; my = p.y * 2 - 1; px = p.x; py = p.y;
      if (dragging) {
        const now = performance.now(), dx = e.clientX - lastX;
        moved += Math.abs(dx); ry += dx * 0.6; vy = (dx * 0.6) / Math.max(now - lastT, 8);
        lastX = e.clientX; lastT = now;
      } else if (!reduce && Math.random() < 0.35) { const [cx, cy] = toCanvas(p.x, p.y); spawn(cx, cy, 1, 0.6, 900); }
    });
    stage.addEventListener('pointerdown', (e) => {
      dragging = true; moved = 0; lastX = e.clientX; lastT = downAt = performance.now();
      stage.classList.add('e3-drag');
      try { stage.setPointerCapture(e.pointerId); } catch { /* ignore */ }
    });
    const end = (e: PointerEvent) => {
      if (!dragging) return;
      dragging = false; stage.classList.remove('e3-drag');
      if (moved < 6 && performance.now() - downAt < 400) {
        if (reduce) ry += 180; else vy = 1.1;
        const p = local(e); const [cx, cy] = toCanvas(p.x, p.y); spawn(cx, cy, 34, 2.4, 1300);
      }
      if (e.pointerType !== 'mouse') { hover = false; stage.classList.remove('e3-hover'); }
    };
    stage.addEventListener('pointerup', end);
    stage.addEventListener('pointercancel', end);

    const star = (x: number, y: number, s: number, rot: number, a: number) => {
      if (!ctx) return;
      ctx.save(); ctx.translate(x, y); ctx.rotate(rot); ctx.globalAlpha = a; ctx.beginPath();
      for (let i = 0; i < 8; i++) { const r = i % 2 ? s * 0.28 : s, an = (i * Math.PI) / 4; ctx.lineTo(Math.cos(an) * r, Math.sin(an) * r); }
      ctx.closePath(); ctx.fill(); ctx.restore();
    };

    const tick = (now: number, dt: number) => {
      const k = 1 - Math.pow(0.9, dt / 16);
      if (!dragging) {
        if (hover && Math.abs(vy) < idle * 3 + 0.02) {
          const target = Math.round(ry / 360) * 360 + mx * cfg.tilt;
          ry += (target - ry) * k * 0.9; vy += (0 - vy) * k; rx += (-my * cfg.tilt * 0.8 - rx) * k;
        } else {
          vy += (idle - vy) * k * 0.12; ry += vy * dt; rx += (0 - rx) * k * 0.5;
        }
      }
      const bob = reduce ? 0 : Math.sin((now - t0) / 1100) * stage.clientWidth * 0.02;
      flt.style.transform = `translateY(${bob.toFixed(2)}px)`;
      obj.style.transform = `rotateX(${rx.toFixed(2)}deg) rotateY(${ry.toFixed(2)}deg) scale(${hover ? 1.06 : 1})`;
      const rad = (ry * Math.PI) / 180, cos = Math.cos(rad);
      obj.style.setProperty('--sx', (hover && !dragging ? 50 - mx * 45 : 50 + Math.sin(rad) * 70).toFixed(1) + '%');
      obj.style.setProperty('--cx', (hover ? px * 100 : 30).toFixed(1) + '%');
      obj.style.setProperty('--cy', (hover ? py * 100 : 25).toFixed(1) + '%');
      obj.style.setProperty('--so', (hover ? 0.75 : 0.25 + 0.35 * Math.abs(cos)).toFixed(2));
      if (shadow) shadow.style.transform = `scaleX(${(0.45 + 0.55 * Math.abs(cos)).toFixed(3)})`;
      if (!ctx || !canvas) return;
      if (!reduce && Math.random() < dt / 260) { const [cx, cy] = toCanvas(0.25 + Math.random() * 0.5, 0.2 + Math.random() * 0.55); spawn(cx, cy, 1, 0.15, 1400); }
      ctx.clearRect(0, 0, canvas.width, canvas.height);
      if (!parts.length) return;
      ctx.globalCompositeOperation = 'lighter';
      const [r, g, b] = cfg.spark;
      for (let i = parts.length - 1; i >= 0; i--) {
        const p = parts[i]; p.age += dt;
        if (p.age > p.life) { parts.splice(i, 1); continue; }
        p.x += (p.vx * dt) / 16; p.y += (p.vy * dt) / 16; p.vx *= 0.97; p.vy = p.vy * 0.97 - (0.004 * dt) / 16; p.rot += (0.02 * dt) / 16;
        const life = p.age / p.life, a = Math.sin(life * Math.PI);
        ctx.fillStyle = `rgb(${r},${g},${b})`; star(p.x, p.y, p.size * (1 - life * 0.4), p.rot, a * 0.9);
        ctx.fillStyle = 'rgb(255,250,230)'; star(p.x, p.y, p.size * 0.45, p.rot, a);
      }
      ctx.globalCompositeOperation = 'source-over';
    };
    const inst: Inst = { el: stage, visible: true, tick };
    all.push(inst);
    io.observe(stage);
  }

  const io = new IntersectionObserver((entries) => {
    for (const e of entries) { const i = all.find((x) => x.el === e.target); if (i) i.visible = e.isIntersecting; }
  }, { rootMargin: '100px' });

  let last = performance.now();
  const loop = (now: number) => {
    const dt = Math.min(now - last, 50); last = now;
    for (const i of all) if (i.visible) i.tick(now, dt);
    requestAnimationFrame(loop);
  };

  document.querySelectorAll<HTMLElement>('[data-emblem3d]').forEach(setup);
  requestAnimationFrame(loop);
</script>

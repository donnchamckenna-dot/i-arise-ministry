---
/** Small hand-drawn motifs: a snowflake (Oxford/Narnia winter), a rose (Jane Austen). Decorative. */
interface Props { kind: 'snow' | 'rose' | 'star'; size?: number; class?: string; }
const { kind, size = 28, class: cls = '' } = Astro.props;
---
<svg width={size} height={size} viewBox="-20 -20 40 40" class={cls} aria-hidden="true">
  {kind === 'snow' && (
    <g stroke="currentColor" stroke-width="2" stroke-linecap="round" fill="none">
      {[0, 60, 120].map((r) => <path transform={`rotate(${r})`} d="M0-16V16M0-16l-4-4M0-16l4-4M0 16l-4 4M0 16l4 4M0-8l-4-3M0-8l4-3M0 8l-4 3M0 8l4 3" />)}
    </g>
  )}
  {kind === 'rose' && (
    <g>
      <ellipse cx="-9" cy="11" rx="8" ry="3.6" fill="#6f8f5e" transform="rotate(-35 -9 11)" />
      <ellipse cx="9" cy="11" rx="8" ry="3.6" fill="#6f8f5e" transform="rotate(35 9 11)" />
      {[0, 72, 144, 216, 288].map((r) => <ellipse cx="0" cy="-6.5" rx="7" ry="8" fill="#d9666c" transform={`rotate(${r})`} />)}
      <circle r="7.5" fill="#c44a53" />
      <path d="M-4.5 .5C-4.5-4.5 4.5-5 4.5 0C4.5 4-2 4.5-2 .5C-2-2 2-2 2 .5" fill="none" stroke="#8f2a33" stroke-width="1.4" stroke-linecap="round" />
    </g>
  )}
  {kind === 'star' && <path d="M0-16L3.5-3.5 16 0 3.5 3.5 0 16-3.5 3.5-16 0-3.5-3.5Z" fill="currentColor" />}
</svg>
